QMainWindow#AppWindow,
QWidget#AppRoot,
QWidget#Page {
    background-color: #090c12;
}

QWidget {
    color: #f4f6fb;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
}

QMenuBar {
    background-color: #090c12;
    color: #aeb7c7;
    border-bottom: 1px solid #161d29;
    padding: 2px 8px;
}

QMenuBar::item { padding: 7px 12px; border-radius: 7px; }
QMenuBar::item:selected { background-color: #171e2b; color: #ffffff; }

QMenu {
    background-color: #111722;
    border: 1px solid #273247;
    border-radius: 9px;
    padding: 6px;
}

QMenu::item { padding: 8px 22px; border-radius: 6px; }
QMenu::item:selected { background-color: #6f4cff; color: #ffffff; }

QFrame#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #111624, stop:0.55 #0d121c, stop:1 #0a0e16);
    border-right: 1px solid #20293a;
}

QLabel#BrandMark,
QLabel#AboutMark {
    color: #07120d;
    font-size: 17px;
    font-weight: 900;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #8a5cff, stop:0.48 #5f72ff, stop:1 #35e58c);
    border: 1px solid #9374ff;
    border-radius: 12px;
}

QLabel#BrandTitle {
    color: #ffffff;
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 800;
}

QLabel#BrandEdition,
QLabel#SidebarSection {
    color: #7f8aa0;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 1px;
}

QListWidget#SidebarNavigation {
    background-color: transparent;
    border: none;
    outline: none;
    color: #aeb7c7;
    font-size: 14px;
    font-weight: 650;
}

QListWidget#SidebarNavigation::item {
    border: 1px solid transparent;
    border-radius: 11px;
    padding-left: 12px;
    margin: 2px 0;
}

QListWidget#SidebarNavigation::item:hover { background-color: #171e2b; color: #ffffff; }

QListWidget#SidebarNavigation::item:selected {
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #32246a, stop:0.7 #253552, stop:1 #173f3c);
    border: 1px solid #7357e8;
}

QFrame#SidebarRuntimeCard {
    background-color: #101a1a;
    border: 1px solid #21443a;
    border-radius: 10px;
}

QLabel#RuntimeTitle { color: #48e298; font-size: 10px; font-weight: 900; }
QLabel#SidebarFooter,
QLabel#MutedText { color: #8792a5; font-size: 12px; }

QLabel#PageTitle {
    color: #ffffff;
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 31px;
    font-weight: 850;
}

QLabel#PageSubtitle { color: #929db0; font-size: 13px; }

QLabel#SectionTitle,
QLabel#EmptyStateTitle {
    color: #ffffff;
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 800;
}

QLabel#StatChip {
    color: #e7ebf3;
    background-color: #121925;
    border: 1px solid #29354a;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 12px;
    font-weight: 750;
}

QFrame#Card,
QFrame#PreviewCard,
QFrame#EmptyState {
    background-color: #111722;
    border: 1px solid #263247;
    border-radius: 12px;
}

QFrame#Card:hover { border-color: #35455f; }

QLabel#InputLabel {
    color: #9aa6ba;
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 1px;
}

QLineEdit,
QLineEdit#Input,
QComboBox,
QComboBox#Input,
QSpinBox,
QSpinBox#Input {
    background-color: #090e16;
    color: #ffffff;
    border: 1px solid #2a374c;
    border-radius: 9px;
    padding: 8px 11px;
    selection-background-color: #7558ff;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus { border: 1px solid #7a5cff; background-color: #0b111b; }
QLineEdit::placeholder { color: #59667a; }
QComboBox::drop-down { border: none; width: 26px; }

QComboBox QAbstractItemView {
    background-color: #111722;
    color: #ffffff;
    border: 1px solid #344158;
    selection-background-color: #6848e8;
    outline: none;
}

QPushButton { min-height: 18px; }

QPushButton#PrimaryButton {
    color: #07130e;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #36e28b, stop:0.55 #42db9a, stop:1 #48d8bb);
    border: 1px solid #4beca3;
    border-radius: 9px;
    padding: 8px 16px;
    font-weight: 900;
}

QPushButton#PrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4bef9d, stop:1 #54e9c8);
    border-color: #78ffc0;
}

QPushButton#PrimaryButton:pressed { background-color: #28c979; }

QPushButton#SecondaryButton {
    color: #dce2ed;
    background-color: #171f2c;
    border: 1px solid #303e55;
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 700;
}

QPushButton#SecondaryButton:hover { color: #ffffff; background-color: #202a3a; border-color: #765cff; }

QPushButton#DangerButton {
    color: #ff9cab;
    background-color: #28171e;
    border: 1px solid #61303d;
    border-radius: 9px;
    padding: 8px 14px;
    font-weight: 750;
}

QPushButton#DangerButton:hover { background-color: #381b25; border-color: #b44b65; }
QPushButton:disabled { color: #667185; background-color: #151b25; border-color: #252e3e; }

QLabel#PreviewArtwork,
QLabel#TaskThumbnail {
    color: #ffffff;
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 16px;
    font-weight: 900;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #291c62, stop:0.38 #7136e8, stop:0.72 #347aca, stop:1 #22c795);
    border: 1px solid #7157d9;
    border-radius: 10px;
}

QLabel#TaskThumbnail {
    font-size: 13px;
    border-color: #465377;
}

QFrame#EmptyState {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #101622, stop:0.5 #111824, stop:1 #101c20);
    border: 1px dashed #34435a;
}

QLabel#EmptyStateIcon { color: #55e5a2; font-size: 26px; font-weight: 500; }

QFrame#NoticeCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #0e1c19, stop:0.62 #101b1b, stop:1 #121927);
    border: 1px solid #24513f;
    border-radius: 11px;
}

QLabel#NoticeTitle { color: #dcffeb; font-size: 13px; font-weight: 850; }
QLabel#NoticeText { color: #8eb8a5; font-size: 11px; }

QFrame#ToolsHero,
QFrame#AboutHero {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #211a49, stop:0.43 #182347, stop:0.76 #12373c, stop:1 #104331);
    border: 1px solid #51429b;
    border-radius: 14px;
}

QLabel#HeroTitle {
    color: #ffffff;
    font-family: "Segoe UI Variable Display", "Segoe UI", sans-serif;
    font-size: 20px;
    font-weight: 850;
}

QLabel#HeroText,
QLabel#AboutText { color: #b8c5d8; font-size: 13px; }

QLabel#HeroBadge {
    color: #caffdf;
    background-color: rgba(34, 213, 139, 45);
    border: 1px solid #42dc98;
    border-radius: 9px;
    padding: 8px 14px;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1px;
}

QLabel#ToolStatus {
    color: #d8deea;
    background-color: #0c111a;
    border: 1px solid #222d3e;
    border-radius: 8px;
    padding: 11px 13px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QTextEdit#LogPanel {
    color: #aebacc;
    background-color: #090e16;
    border: 1px solid #27344a;
    border-radius: 10px;
    padding: 12px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 11px;
}

QListWidget#HistoryList {
    color: #dce2ed;
    background-color: #0d121b;
    border: 1px solid #253147;
    border-radius: 11px;
    outline: none;
    padding: 6px;
}

QListWidget#HistoryList::item {
    background-color: #121925;
    border: 1px solid #263247;
    border-radius: 8px;
    padding: 12px;
    margin: 4px;
}

QListWidget#HistoryList::item:selected { background-color: #282052; border-color: #755cff; }

QProgressBar {
    color: #ffffff;
    background-color: #090e16;
    border: 1px solid #27344a;
    border-radius: 5px;
    min-height: 10px;
    text-align: center;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7658ff, stop:0.52 #477be5, stop:1 #38df91);
    border-radius: 4px;
}

QCheckBox { color: #d4dbe7; spacing: 9px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 5px; }
QCheckBox::indicator:unchecked { background-color: #090e16; border: 1px solid #35435a; }
QCheckBox::indicator:checked { background-color: #39df8c; border: 1px solid #62f2aa; }

QScrollArea,
QWidget#QueueContainer { background-color: transparent; border: none; }

QScrollBar:vertical { background-color: #0b1018; width: 9px; border-radius: 4px; }
QScrollBar::handle:vertical { background-color: #303c50; border-radius: 4px; min-height: 32px; }
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }

QStatusBar {
    color: #91a0b5;
    background-color: #0b1018;
    border-top: 1px solid #1c2635;
}
